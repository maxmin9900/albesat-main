# PostgreSQL
POSTGRES_USER=carpet
POSTGRES_PASSWORD=carpet_secret
POSTGRES_DB=carpet_samir

# App
DATABASE_URL=postgresql://carpet:carpet_secret@db:5432/carpet_samir?schema=public
JWT_SECRET=change_this_in_prod_super_secret_key

# Default admin (created on seed)
ADMIN_EMAIL=admin@carpetsamir.com
ADMIN_PASSWORD=Admin@12345

# ---- Live auction defaults (each auction snapshots these at creation) ----
AUCTION_DEPOSIT_PERCENT=50
AUCTION_BID_INCREMENT_PERCENT=20
AUCTION_BID_COVERAGE_PERCENT=100
AUCTION_ANTI_SNIPING_WINDOW_SEC=30
AUCTION_EXTENSION_SEC=30
AUCTION_PAYMENT_DEADLINE_MIN=30
AUCTION_FAILED_PAYMENT_DEPOSIT_POLICY=RELEASE   # or FORFEIT
AUCTION_OFFER_TO_NEXT_BIDDER=false
AUCTION_SWEEPER_INTERVAL_MS=3000
