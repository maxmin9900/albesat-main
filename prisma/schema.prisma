// Carpet Samir — Collection & Auction back-office data model
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ArtworkStatus {
  DRAFT
  PRIVATE
  PUBLISHED
  SOLD
  ARCHIVED
}

enum Currency {
  OMR
  IRR
  USD
  EUR
  AED
}

enum ImageType {
  MAIN // تصویر اصلی
  GALLERY // گالری تصاویر
  WEAVE_CLOSEUP // نمای نزدیک از بافت
  BACK // نمای پشت فرش
  KNOT_DETAIL // جزئیات گره
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  PACKED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderSource {
  DIRECT
  AUCTION
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  REGISTRATION_OPEN // members may join and lock their deposit; bidding not yet open
  LIVE
  ENDED // hammer fell — winner being determined
  PAYMENT_PENDING // winner has a deadline to pay the balance
  COMPLETED
  CANCELLED
  SETTLEMENT_FAILED // winner did not pay in time
}

enum BidStatus {
  VALID
  OUTBID
  WINNING
  REJECTED
  SUSPICIOUS
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ---- Live auction ---------------------------------------------------------

enum DepositStatus {
  LOCKED // held for the duration of the auction
  RELEASED // returned — the member did not win (or the auction was cancelled)
  APPLIED // counted toward the winner's purchase
  FORFEITED // kept — the winner failed to pay in time (policy-dependent)
}

// what happens to the winner's deposit if the balance is not paid in time
enum FailedPaymentDepositPolicy {
  RELEASE
  FORFEIT
}

enum WalletTxType {
  CREDIT // funds added (admin-confirmed bank transfer / cheque / card)
  DEBIT // funds taken out
  LOCK // moved available -> locked (auction deposit)
  RELEASE // moved locked -> available
  APPLY // locked funds consumed by a purchase
  ADJUST // admin correction, always with a note
}

enum AuctionEventType {
  AUCTION_CREATED
  AUCTION_SCHEDULED
  REGISTRATION_OPENED
  AUCTION_STARTED
  USER_JOINED
  DEPOSIT_LOCKED
  BID_PLACED
  BID_REJECTED
  BID_OUTBID
  AUCTION_EXTENDED
  AUCTION_ENDED
  WINNER_SELECTED
  PAYMENT_STARTED
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  DEPOSIT_RELEASED
  DEPOSIT_APPLIED
  DEPOSIT_FORFEITED
  AUCTION_COMPLETED
  AUCTION_CANCELLED
  SETTLEMENT_FAILED
}

// ---------------------------------------------------------------------------
// Back-office administrators
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

// ---------------------------------------------------------------------------
// CRM — site users / bidders / buyers
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  fullName     String
  mobile       String?   @unique
  email        String?   @unique
  passwordHash String? // site login (bidders/buyers)
  address      String?   @db.Text // picked on the Oman map at registration
  country      String?
  kycStatus    KycStatus @default(PENDING)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders    Order[]
  bids      Bid[]
  favorites Favorite[]
  wins      AuctionWinner[]
  wallet    Wallet?
  auctionParticipations AuctionParticipant[]

  @@index([mobile])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Collection — Artworks
// ---------------------------------------------------------------------------

model Artwork {
  id                 String        @id @default(cuid())
  code               String        @unique // کد اثر (auto-generated)
  title              String // عنوان اثر
  city               String // شهر
  category           String // دسته‌بندی
  price              Decimal       @db.Decimal(14, 2) // قیمت
  currency           Currency      @default(USD) // واحد پول
  dimensions         String? // ابعاد به صورت متن — از lengthCm/widthCm ساخته می‌شود
  lengthCm           Float? // طول به سانتی‌متر
  widthCm            Float? // عرض به سانتی‌متر
  pileMaterial       String? // جنس پرز
  foundationMaterial String? // جنس تار و پود
  knotDensity        String? // تراکم گره
  approxAge          String? // سن تقریبی
  condition          String? // وضعیت اثر
  description        String? // توضیحات
  status             ArtworkStatus @default(DRAFT)

  // AI-estimated intrinsic value. Written through ValuationService
  // (src/lib/auction/valuation.ts); it is the auction's starting price.
  intrinsicValue       Decimal?  @db.Decimal(14, 2)
  intrinsicValueSource String? // "manual" | "ai:<model>" - who produced it
  intrinsicValuedAt    DateTime?

  // engagement metrics (used by reports)
  viewsCount     Int @default(0)
  favoritesCount Int @default(0)

  images    ArtworkImage[]
  dossier   Dossier?
  orders    Order[]
  /// sessions this work headlines — see the note on Auction.artworkId
  auctions  Auction[]
  /// every session this work is a lot in (the real "is it up for sale?")
  lots      AuctionLot[]
  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([city])
  @@index([category])
}

model ArtworkImage {
  id        String    @id @default(cuid())
  artworkId String
  artwork   Artwork   @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  url       String
  type      ImageType @default(GALLERY)
  alt       String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([artworkId])
}

// Dossier — اطلاعات اصالت اثر (Authenticity dossier)
model Dossier {
  id             String  @id @default(cuid())
  artworkId      String  @unique
  artwork        Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  origin         String? // Origin
  dimensions     String? // Dimensions
  material       String? // Material
  foundation     String? // Foundation
  age            String? // Age
  condition      String? // Condition
  authentication String? // Authentication
  craftStory     String? @db.Text // Craft Story
  artisan        String? // Artisan
  collection     String? // Collection
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  artworkId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, artworkId])
  @@index([artworkId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  artworkId     String
  artwork       Artwork       @relation(fields: [artworkId], references: [id])
  customerName  String
  amount        Decimal       @db.Decimal(14, 2)
  currency      Currency      @default(USD)
  address       String        @db.Text
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)
  trackingCode  String?
  source        OrderSource   @default(DIRECT)
  notes         String?       @db.Text

  auctionWinner AuctionWinner?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Auctions
// ---------------------------------------------------------------------------

/// A sale SESSION. It holds one or more lots (see AuctionLot) and the people
/// who registered for it — registration is per session, not per carpet.
///
/// `artworkId` is the session's headline carpet. The live bidding room, the
/// winner record and the legacy reports all hang off that one work; the
/// public catalogue and the admin panel read `lots` instead. It is no longer
/// unique, so a carpet that did not sell can head a later session.
model Auction {
  id              String        @id @default(cuid())
  title           String
  artworkId       String
  artwork         Artwork       @relation(fields: [artworkId], references: [id])
  basePrice       Decimal       @db.Decimal(14, 2) // legacy column - always equals startingPrice
  minBidIncrement Decimal       @db.Decimal(14, 2) // legacy column - kept for old rows/pages; live rule is bidIncrementPercent
  currency        Currency      @default(USD)
  startAt         DateTime // تاریخ شروع
  endAt           DateTime // تاریخ پایان (moves forward on anti-sniping extensions)
  status          AuctionStatus @default(DRAFT)

  // ---- financial rules, snapshotted per auction so a later default change
  //      never rewrites the terms members already agreed to ----------------
  startingPrice        Decimal @default(0) @db.Decimal(14, 2) // = artwork.intrinsicValue at creation
  depositPercent       Decimal @default(50) @db.Decimal(5, 2) // % of intrinsic value locked to join
  bidIncrementPercent  Decimal @default(20) @db.Decimal(5, 2) // next bid >= current * (1 + this%)
  bidCoveragePercent   Decimal @default(100) @db.Decimal(5, 2) // bidder must hold this % of the bid (available + own deposit)
  antiSnipingWindowSec Int     @default(30)
  extensionSec         Int     @default(30)
  paymentDeadlineMin   Int     @default(30)
  failedPaymentDepositPolicy FailedPaymentDepositPolicy @default(RELEASE)
  offerToNextBidder    Boolean @default(false) // on settlement failure, promote the runner-up

  // ---- the printed invitation -------------------------------------------
  // What the public auctions page prints above the registration form, and
  // what the confirmation names back to the visitor. All optional: a session
  // with none of it falls back to generic wording.
  venueName    String? // short, for a sentence: "National Museum of Oman"
  venueAddress String? // the line under the date, with the city
  venueHall    String? // the "Venue:" detail line
  intro        String? // one line describing the sale
  viewingFrom  String? // "17:00" - free text, these are printed not computed
  viewingTo    String? // "19:00"

  // ---- live state - only ever changed inside a row-locked transaction ----
  currentPrice   Decimal   @default(0) @db.Decimal(14, 2)
  bidSequence    Int       @default(0) // last accepted bid's sequence number
  version        Int       @default(0) // bumped on every state change (optimistic guard)
  originalEndAt  DateTime?
  extensionCount Int       @default(0)
  registrationOpensAt DateTime?
  endedAt        DateTime?
  paymentDueAt   DateTime?
  completedAt    DateTime?

  lots          AuctionLot[]
  bids          Bid[]
  winner        AuctionWinner?
  participants  AuctionParticipant[]
  registrations AuctionRegistration[]
  events        AuctionEvent[]
  walletTxs     WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([endAt])
}

model Bid {
  id        String    @id @default(cuid())
  auctionId String
  auction   Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  amount    Decimal   @db.Decimal(14, 2)
  status    BidStatus @default(VALID)
  ipAddress String?
  country   String?
  createdAt DateTime  @default(now())

  // Rows are never edited after insert. A bad bid is inserted as REJECTED with
  // its reason; sequence is assigned only to accepted bids, so it is a gap-free
  // order of the price history.
  sequence        Int?
  rejectionReason String?
  idempotencyKey  String? // client-generated per submit; a retry returns the same bid

  @@unique([auctionId, sequence])
  @@unique([auctionId, userId, idempotencyKey])
  @@index([auctionId])
  @@index([userId])
  @@index([status])
}

model AuctionWinner {
  id          String   @id @default(cuid())
  auctionId   String   @unique
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  finalAmount Decimal  @db.Decimal(14, 2)
  bidCount    Int      @default(0)
  endedAt     DateTime
  emailSent   Boolean  @default(false)
  smsSent     Boolean  @default(false)
  orderId     String?  @unique
  order       Order?   @relation(fields: [orderId], references: [id])
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Live auction - participants, member funds, audit trail
// ---------------------------------------------------------------------------

model AuctionParticipant {
  id            String        @id @default(cuid())
  auctionId     String
  auction       Auction       @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  alias         String // "Bidder #A21" - what other members see
  depositAmount Decimal       @db.Decimal(14, 2)
  depositStatus DepositStatus @default(LOCKED)
  joinedAt      DateTime      @default(now())
  settledAt     DateTime? // when the deposit left LOCKED

  @@unique([auctionId, userId])
  @@index([userId])
}

// Member funds. There was no wallet or gateway in the project, so this is the
// smallest ledger that can hold, lock and apply an auction deposit. Balances
// are columns (updated under a row lock) and every movement is also written
// as an immutable WalletTransaction, which is the audit trail.
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  Currency @default(OMR)
  available Decimal  @default(0) @db.Decimal(14, 2)
  locked    Decimal  @default(0) @db.Decimal(14, 2)
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id             String       @id @default(cuid())
  walletId       String
  wallet         Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type           WalletTxType
  amount         Decimal      @db.Decimal(14, 2)
  availableAfter Decimal      @db.Decimal(14, 2)
  lockedAfter    Decimal      @db.Decimal(14, 2)
  auctionId      String?
  auction        Auction?     @relation(fields: [auctionId], references: [id])
  bidId          String?
  note           String?
  createdByAdmin String? // admin user id for CREDIT/DEBIT/ADJUST
  createdAt      DateTime     @default(now())

  @@index([walletId, createdAt])
  @@index([auctionId])
}

// Append-only event log. Doubles as the real-time feed: the SSE stream ships
// rows with id > the client's cursor.
model AuctionEvent {
  id        Int              @id @default(autoincrement())
  auctionId String
  auction   Auction          @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  type      AuctionEventType
  userId    String? // the member the event is about, if any
  bidId     String?
  payload   Json?
  createdAt DateTime         @default(now())

  @@index([auctionId, id])
}

// ---------------------------------------------------------------------------
// Taxonomy — the weaving cities and the style categories the archive covers.
//
// These used to be hard-coded lists in src/lib/labels.ts, which meant adding a
// city or a category needed a redeploy. They now live here so the admin panel
// can manage them (see /admin/taxonomy). The tables are seeded from the old
// hard-coded lists on first read — see src/lib/taxonomy.ts.
// ---------------------------------------------------------------------------

model City {
  id        String  @id @default(cuid())
  name      String  @unique // as shown and as stored on Artwork.city, e.g. "Esfahan"
  slug      String  @unique // lowercase URL key used by /collection?city=…
  province  String?
  sortOrder Int     @default(0)
  active    Boolean @default(true) // hidden from the pickers; existing works keep it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model Category {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

// ---------------------------------------------------------------------------
// Interest in a lot, captured from the public auctions page.
//
// Deliberately NOT AuctionParticipant: that one is the live-bidding record and
// needs a registered User with a locked deposit. This is the lightweight
// "put me on the list" form — a name, a phone, an email — so a visitor can
// register for a carpet without an account. The admin panel lists them per lot.
// ---------------------------------------------------------------------------

model AuctionRegistration {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String

  contacted Boolean @default(false) // ticked off by the admin once called
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // one entry per person per lot — a second submission updates the first
  @@unique([auctionId, email])
  @@index([auctionId, createdAt])
}

/// One carpet inside a sale session, with the catalogue entry the public
/// listing prints. The entry lives here rather than on the Artwork because
/// the same carpet can come back in a later session as a different lot, with
/// a fresh estimate and a fresh reserve, and the old listing must not change.
model AuctionLot {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id])

  sortOrder Int @default(0) // running order within the session

  // ---- the printed catalogue entry ----
  lotNumber        Int? // "LOT 25"
  lotName          String? // headline, e.g. "Antique Qashqai Carpet"
  origin           String? // "Fars, Iran"
  era              String? // "1920s"
  lotDimensions    String? // "218 x 145 cm" - free text, sizes are quoted many ways
  materials        String? // "Hand-spun wool pile on wool foundation"
  weave            String? // "Hand-knotted"
  condition        String? // "Very good for age, with expected minor signs of use"
  estimateLow      Decimal? @db.Decimal(14, 2)
  estimateHigh     Decimal? @db.Decimal(14, 2)
  publishedReserve Decimal? @db.Decimal(14, 2)
  lotNote          String?
  startingPrice    Decimal? @db.Decimal(14, 2) // what this lot opens at

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // a carpet appears at most once in a given session
  @@unique([auctionId, artworkId])
  @@index([auctionId, sortOrder])
  @@index([artworkId])
}
